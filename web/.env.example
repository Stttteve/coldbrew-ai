# ──────────────────────────────────────────────────────────────────────
# Coldbrew AI — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ──────────────────────────────────────────────────────────────────────

# Node
NODE_ENV=development

# ── Database & queue ─────────────────────────────────────────────────
# Matches docker-compose.yml (Postgres on host port 5433, Redis on 6380)
DATABASE_URL="postgresql://coldbrew:coldbrew@localhost:5433/coldbrew?schema=public"
REDIS_URL="redis://localhost:6380"

# ── Auth.js ──────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-48-byte-random-string"
# For local dev use http://localhost:3002. In Vercel, set this to the real
# production URL assigned to your project.
AUTH_URL="https://your-vercel-project.vercel.app"

# Google SSO (login only — openid email profile). Optional for dev.
# Create at: https://console.cloud.google.com/apis/credentials
#   App type: Web application
#   Authorized redirect URI: https://your-vercel-project.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Gmail provider OAuth (gmail.compose — separate from SSO above) ───
# Create a SECOND OAuth client in the same Google Cloud project:
#   App type: Web application
#   Authorized redirect URI: https://your-vercel-project.vercel.app/api/oauth/google/callback
# Consent screen needs scopes: .../auth/gmail.compose + openid email profile
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
# Deprecated: Gmail OAuth now derives the redirect URI from the request origin.
# Keep this only if older code paths or external tooling still reference it.
GMAIL_OAUTH_REDIRECT_URI="https://your-vercel-project.vercel.app/api/oauth/google/callback"

# ── Envelope encryption master key (dev only) ────────────────────────
# Generate: openssl rand -hex 32
# In prod: replace with a KMS-backed KEK and update src/lib/crypto.ts
DATA_ENCRYPTION_KEY=""

# ── LLM providers ────────────────────────────────────────────────────
# The adapter factory picks the first configured key, in this order:
#   Gemini → Anthropic → OpenAI → Stub (deterministic, zero-dep)
#
# Google AI Studio is recommended for development: generous free tier, no
# credit card needed. Get a key at https://aistudio.google.com/apikey.
GOOGLE_API_KEY=""
# Optional: override default Gemini models.
# Note: Gemini 2.5 Pro is NOT in the free tier as of late-2025 — stick with
# 2.5-flash for both tiers until you have a paid Google Cloud billing account.
# GEMINI_MODEL_FAST="gemini-2.5-flash"
# GEMINI_MODEL_STRONG="gemini-2.5-pro"   # paid only

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ── Enrichment providers (Phase 3+) ──────────────────────────────────
HUNTER_API_KEY=""
APOLLO_API_KEY=""
PROXYCURL_API_KEY=""

# ── Feature flags ────────────────────────────────────────────────────
FEATURE_OUTLOOK=false
# When true, enrichment + draft jobs go through BullMQ. When false (the dev
# default), they run inline on the request. In prod set this to true AND run
# `tsx src/workers/enrichment.ts` + `tsx src/workers/draft.ts` alongside the app.
USE_QUEUE_WORKERS=false

# ── Client-exposed vars ──────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Coldbrew AI"
